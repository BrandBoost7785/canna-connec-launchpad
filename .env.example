# Canna-Connec — environment variable NAMES ONLY.
#
# Copy to `.env` (or `.env.local`) for local development and fill in values from
# YOUR OWN development Supabase project. `.env` files are git-ignored; never commit
# real values and never reuse production credentials in development or staging.
#
# Only the variables below are read by the code in the repository today.
# Variables for payments, notifications, etc. will be added in the phases that
# introduce them. The database test suite (`bun run test:db`) needs NONE of these:
# it starts its own throw-away PostgreSQL server.

# --- Supabase (public / browser-safe) -------------------------------------
# Project URL and publishable (anon-level) key. Safe to expose to the browser,
# but still supplied through the environment rather than source control.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (SERVER-ONLY SECRET) ------------------------------------------
# Service-role key bypasses Row Level Security. Server runtime only.
# NEVER prefix with VITE_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduled jobs (SERVER-ONLY SECRET) ------------------------------------
# Bearer secret checked by src/integrations/supabase/cron-auth.ts.
# The *_PREVIOUS variable allows secret rotation. Leave unset if unused.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# --- First-run setup (SERVER-ONLY SECRET) -----------------------------------
# Random string (>= 32 chars) that the person deploying the installation hands to
# the business owner. Required to submit /setup. While unset, first-run setup is
# disabled. Generate with: openssl rand -base64 48
# Remove/rotate it after setup; setup can never be re-run once completed.
SETUP_TOKEN=

# Throttle for the /setup endpoint itself (it exists before any owner configuration
# can). Both are required positive integers; setup stays disabled until both are set.
# Choose values appropriate for your deployment - there is no built-in default.
SETUP_RATE_LIMIT_ATTEMPTS=
SETUP_RATE_LIMIT_WINDOW_SECONDS=

# --- Rate limiting (SERVER-ONLY SECRET) -------------------------------------
# Random string (>= 32 chars) used to HMAC rate-limit keys so raw IPs / Client
# Codes are never stored. If unset or too short, login and setup FAIL CLOSED.
RATE_LIMIT_KEY_SECRET=
# Name of the request header that carries the real client IP and is set by YOUR
# trusted proxy (e.g. cf-connecting-ip on Cloudflare). Leave unset if unknown:
# all callers then share one rate-limit bucket (safe but easy to exhaust).
CLIENT_IP_HEADER=

# --- Security headers --------------------------------------------------------
# Space-separated origins allowed to embed the site in a frame. Default 'none'.
# Only set if embedding is intentionally required (e.g. a preview environment).
CSP_FRAME_ANCESTORS=

# --- Real-Supabase verification (tests/supabase-real) ----------------------------------------
# Put these ONLY in the git-ignored file .env.supabase-test.local (never here), and ONLY for a
# dedicated, disposable test project. See docs/REAL_SUPABASE_VERIFICATION.md.
# SUPABASE_DB_URL=
# SUPABASE_VERIFY_PROJECT_REF=
# SUPABASE_VERIFY_CONFIRM=
